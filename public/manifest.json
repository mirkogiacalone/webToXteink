{
  "manifest_version": 3,
  "name": "WebToEPUB Xteink",
  "version": "1.0.0",
  "description": "Web → EPUB per Xteink X4",
  "permissions": ["storage", "downloads", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": {"default_popup": "popup.html"},
  "background": {"service_worker": "background.js"},
  "content_scripts": [
  {
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_end"
  }
],
"web_accessible_resources": [{
    "resources": ["lib/jszip.min.js"],
    "matches": ["<all_urls>"]
  }]

}
