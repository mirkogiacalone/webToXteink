{
  "manifest_version": 3,
  "name": "WebToXteink",
  "version": "1.0.0",
  "description": "Convert web pages to EPUB and send to Xteink X4",
  "permissions": [
    "storage",
    "activeTab",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://192.168.3.3/*",
    "http://192.168.4.1/*",
    "http://192.168.*.*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WebToXteink",
    "default_icon": {
      "16": "icon-v2-16.png",
      "48": "icon-v2-48.png",
      "128": "icon-v2-128.png"
    }
  },
  "icons": {
    "16": "icon-v2-16.png",
    "48": "icon-v2-48.png",
    "128": "icon-v2-128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}