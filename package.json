{
  "name": "webtoepub-extension",
  "version": "1.0.0",
  "description": "Converti pagine web in EPUB e inviale al tuo eReader",
  "main": "index.js",
  "scripts": {
    "dev": "npm run watch",
    "watch": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "test": "jest",
    "lint": "eslint extension/**/*.js",
    "lint:fix": "eslint extension/**/*.js --fix",
    "format": "prettier --write \"extension/**/*.{js,json,html,css}\"",
    "companion:start": "node companion-app/server.js",
    "companion:dev": "nodemon companion-app/server.js"
  },
  "keywords": ["chrome-extension", "epub", "ereader", "web-to-epub"],
  "author": "Il Tuo Nome",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "eslint": "^8.52.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "style-loader": "^3.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "epub-gen-memory": "^1.1.0",
    "jsdom": "^23.0.0"
  }
}
